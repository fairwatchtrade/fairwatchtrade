# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
app/api/watch-ship/

# local tooling workspace and dev server logs — never staged, never shipped
.claude/
dev*.log

# continuity recovery packets are compiled on demand and are never authority
continuity/packets/

# Build archives never belong in the repository. A zip slipped past review
# once and carried an .env.local inside it, where secret scanning cannot look.
*.zip
